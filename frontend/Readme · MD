## Database Schema

```sql
-- Users
CREATE TABLE user (
  id       BIGINT AUTO_INCREMENT PRIMARY KEY,
  name     VARCHAR(255),
  email    VARCHAR(255) UNIQUE,
  password VARCHAR(255),   -- BCrypt hashed
  phone    VARCHAR(20),
  role     VARCHAR(50)     -- USER | RECRUITER | ADMIN
);

-- Jobs
CREATE TABLE job (
  id          BIGINT AUTO_INCREMENT PRIMARY KEY,
  title       VARCHAR(255),
  company     VARCHAR(255),
  location    VARCHAR(255),
  description TEXT,
  salary      VARCHAR(100)
);

-- Applications
CREATE TABLE application (
  id           BIGINT AUTO_INCREMENT PRIMARY KEY,
  user_id      BIGINT REFERENCES user(id),
  job_id       BIGINT REFERENCES job(id),
  status       VARCHAR(50),
  applied_date DATE
);

-- Resume
CREATE TABLE resume_entity (
  id      BIGINT AUTO_INCREMENT PRIMARY KEY,
  user_id BIGINT REFERENCES user(id),
  summary TEXT
);
```

